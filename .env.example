# Copy to .env and fill locally. Never commit keys.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
RESPAWN_AGENT_MODE=auto
RESPAWN_AGENT_MAX_TURNS=24
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
RESPAWN_FALKORDB=server
# Docker is required when executing cloned third-party repositories.
RESPAWN_SANDBOX=docker
# Needed only for the explicit "Open draft PR" action.
GITHUB_TOKEN=

# Hosted frontend/backend wiring (no trailing slash).
NEXT_PUBLIC_RESPAWN_API=
NEXT_PUBLIC_RESPAWN_EXAMPLES_ONLY=0
RESPAWN_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Free container demo only: reject imports and serialize repairs.
RESPAWN_EXAMPLES_ONLY=0
